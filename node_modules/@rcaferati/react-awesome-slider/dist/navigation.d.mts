import React from 'react';

type NavigationState = {
    slug: string;
    goto: string;
    navigating: boolean;
    pop: boolean;
    defaultSlug?: string;
};
type SetNavigation = (next: Partial<NavigationState> | string) => void;
declare const Context: any;
type ProviderProps = {
    slug: string;
    defaultSlug?: string;
    children?: React.ReactNode;
};
declare const Provider: React.FC<ProviderProps>;

declare const _default: {
    (props: object): any;
    displayName: string;
};

type Fullpage = {
    navigation: NavigationState;
    navigate: SetNavigation;
};
type WithNavigationInjectedProps = {
    fullpage: Fullpage;
};
declare function withNavigationContext<P extends object>(Component: React.ComponentType<P & WithNavigationInjectedProps>): {
    (props: P): any;
    displayName: string;
};

declare function withNavigationHandlers<P extends object>(Component: React.ComponentType<P>): any;

export { Context, _default as Link, Provider, withNavigationContext, withNavigationHandlers };
